# Spotify API credentials
# Create an app at https://developer.spotify.com/dashboard
VITE_SPOTIFY_CLIENT_ID=your_client_id_here

# Redirect URI must match one configured in your Spotify Dashboard
# For local development, use: http://localhost:3000/callback
VITE_SPOTIFY_REDIRECT_URI=http://localhost:3000/callback

# Scopes required by the app (space-separated)
VITE_SPOTIFY_SCOPES=user-read-private user-read-email user-read-playback-state user-modify-playback-state user-read-currently-playing user-read-recently-played user-library-read user-library-modify playlist-read-private playlist-read-collaborative playlist-modify-private playlist-modify-public user-follow-read user-follow-modify user-top-read

# Optional: Development overrides
# NODE_ENV=development
# VITE_LOG_LEVEL=debug