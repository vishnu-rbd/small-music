# Copy this file to `.env.local` and fill in your own values.
# `.env.local` is git-ignored. Never commit a real Client ID or a client secret.
#
# The Client ID comes from your Spotify app: https://developer.spotify.com/dashboard
# PKCE needs only the Client ID. There is no client secret in this app, by design.

VITE_SPOTIFY_CLIENT_ID=

# Must match a Redirect URI registered on the Spotify app, character for character.
# Spotify does not accept `localhost`; use the 127.0.0.1 loopback address locally.
# Defaults to http://127.0.0.1:5173/callback when left empty.
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback
